    {
      "parameters": {
        "jsCode": "const data = $json.body ?? $json;\n\nconst requiredFields = [\n  'incident_id',\n  'source',\n  'server',\n  'service',\n  'alert_type',\n  'severity',\n  'message',\n  'timestamp'\n];\n\nconst errors = [];\n\nfor (const field of requiredFields) {\n  if (\n    data[field] === undefined ||\n    data[field] === null ||\n    String(data[field]).trim() === ''\n  ) {\n    errors.push(`Missing required field: ${field}`);\n  }\n}\n\nconst allowedSeverities = [\n  'low',\n  'medium',\n  'high',\n  'critical'\n];\n\nif (\n  data.severity &&\n  !allowedSeverities.includes(\n    String(data.severity).toLowerCase()\n  )\n) {\n  errors.push('Invalid severity value');\n}\n\nreturn [\n  {\n    json: {\n      ...data,\n      input_valid: errors.length === 0,\n      validation_errors: errors\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
