    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"incident_id\": {\n      \"type\": \"string\"\n    },\n    \"source\": {\n      \"type\": \"string\"\n    },\n    \"server\": {\n      \"type\": \"string\"\n    },\n    \"service\": {\n      \"type\": \"string\"\n    },\n    \"alert_type\": {\n      \"type\": \"string\"\n    },\n    \"incident_type\": {\n      \"type\": \"string\"\n    },\n    \"severity\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"low\",\n        \"medium\",\n        \"high\",\n        \"critical\"\n      ]\n    },\n    \"summary\": {\n      \"type\": \"string\"\n    },\n    \"probable_cause\": {\n      \"type\": \"string\"\n    },\n    \"recommended_action\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"check_service_status\",\n        \"inspect_logs\",\n        \"check_disk_usage\",\n        \"check_cpu_usage\",\n        \"check_memory_usage\",\n        \"notify_devops\",\n        \"none\"\n      ]\n    },\n    \"needs_human_review\": {\n      \"type\": \"boolean\"\n    },\n    \"confidence\": {\n      \"type\": \"number\",\n      \"minimum\": 0,\n      \"maximum\": 1\n    }\n  },\n  \"required\": [\n    \"incident_id\",\n    \"source\",\n    \"server\",\n    \"service\",\n    \"alert_type\",\n    \"incident_type\",\n    \"severity\",\n    \"summary\",\n    \"probable_cause\",\n    \"recommended_action\",\n    \"needs_human_review\",\n    \"confidence\"\n  ]\n}"
      },
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        808,
        360
      ],
      "id": "559469b9-5704-46da-a829-bd3415058fa5",
      "name": "Structured Output Parser"
    },
    {
      "parameters": {
        "jsCode": "const data = $json;\n\nconst errors = [];\n\nconst allowedActions = [\n  'check_service_status',\n  'inspect_logs',\n  'check_disk_usage',\n  'check_cpu_usage',\n  'check_memory_usage',\n  'notify_devops',\n  'none'\n];\n\nconst allowedSeverities = [\n  'low',\n  'medium',\n  'high',\n  'critical'\n];\n\n// Validate severity\nif (!allowedSeverities.includes(data.severity)) {\n  errors.push('Invalid severity');\n}\n\n// Validate recommended action\nif (!allowedActions.includes(data.recommended_action)) {\n  errors.push('Invalid recommended action');\n}\n\n// Validate confidence\nif (\n  typeof data.confidence !== 'number' ||\n  data.confidence < 0 ||\n  data.confidence > 1\n) {\n  errors.push('Invalid confidence score');\n}\n\n// Validate human review flag\nif (typeof data.needs_human_review !== 'boolean') {\n  errors.push('Invalid human review flag');\n}\n\n// Critical incidents always require human review\nif (data.severity === 'critical') {\n  data.needs_human_review = true;\n}\n\n// Low confidence requires human review\nif (data.confidence < 0.80) {\n  data.needs_human_review = true;\n}\n\nreturn [\n  {\n    json: {\n      ...data,\n      ai_output_valid: errors.length === 0,\n      ai_validation_errors: errors\n    }\n  }\n];"
      },
