    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"technical_issue\": {\n      \"type\": \"string\"\n    },\n    \"evidence\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\"\n      }\n    },\n    \"probable_root_cause\": {\n      \"type\": \"string\"\n    },\n    \"recommended_action\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"check_service_status\",\n        \"inspect_logs\",\n        \"check_disk_usage\",\n        \"check_cpu_usage\",\n        \"check_memory_usage\",\n        \"notify_devops\",\n        \"none\"\n      ]\n    },\n    \"confidence\": {\n      \"type\": \"number\",\n      \"minimum\": 0,\n      \"maximum\": 1\n    },\n    \"needs_human_review\": {\n      \"type\": \"boolean\"\n    }\n  },\n  \"required\": [\n    \"technical_issue\",\n    \"evidence\",\n    \"probable_root_cause\",\n    \"recommended_action\",\n    \"confidence\",\n    \"needs_human_review\"\n  ]\n}"
      },
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        2504,
        504
      ],
      "id": "f2eb683c-fdb3-40a7-acfb-046c01c656bf",
      "name": "Structured Output Parser1"
    },
    {
      "parameters": {
        "jsCode": "const data = $json.output ?? $json;\n\nconst errors = [];\n\nconst allowedActions = [\n  'check_service_status',\n  'inspect_logs',\n  'check_disk_usage',\n  'check_cpu_usage',\n  'check_memory_usage',\n  'notify_devops',\n  'none'\n];\n\nif (!allowedActions.includes(data.recommended_action)) {\n  errors.push('Invalid recommended action');\n}\n\nif (\n  typeof data.confidence !== 'number' ||\n  data.confidence < 0 ||\n  data.confidence > 1\n) {\n  errors.push('Invalid confidence score');\n}\n\nif (typeof data.needs_human_review !== 'boolean') {\n  errors.push('Invalid human review flag');\n}\n\n// Low-confidence log analysis requires human review\nif (data.confidence < 0.80) {\n  data.needs_human_review = true;\n}\n\nreturn [\n  {\n    json: {\n      ...data,\n      log_decision_valid: errors.length === 0,\n      log_validation_errors: errors\n    }\n  }\n];"
      },
